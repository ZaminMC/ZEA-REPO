{
  "format": "zea-repo/channels",
  "version": 2,
  "writeChannels": [
    {
      "id": "global",
      "name": "Global",
      "commands": ["g", "global"]
    },
    {
      "id": "local",
      "name": "Local",
      "commands": ["local"],
      "messageTag": "Local"
    },
    {
      "id": "trade",
      "name": "Trade",
      "commands": ["tradechat"],
      "messageTag": "Trade"
    },
    {
      "id": "nation",
      "name": "Nation",
      "commands": ["nc", "nationchat"],
      "messageTag": "Nation Chat",
      "messageTagCarriesTown": true
    },
    {
      "id": "town",
      "name": "Town",
      "commands": ["tc"],
      "messageTag": "Town Chat"
    }
  ],
  "readonlyFeeds": [
    {
      "id": "discord",
      "name": "Discord",
      "note": "Messages forwarded from Discord with a [Discord] prefix. Players reply through normal in-game chat; there is no /discordchat command."
    }
  ]
}
