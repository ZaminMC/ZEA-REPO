{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZaminMC/ZEA-REPO/main/schemas/badges.schema.json",
  "title": "ZEA-REPO badges dataset",
  "description": "EarthMC chat badge symbols with community-verified meanings.",
  "type": "object",
  "properties": {
    "format": { "const": "zea-repo/badges" },
    "version": { "const": 1 },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4,
            "description": "The badge as it appears in chat (may be a multi-codepoint emoji)."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Stable machine identifier for this badge."
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Human-readable meaning."
          },
          "verified": {
            "type": "boolean",
            "description": "True only when the meaning has been confirmed on EarthMC."
          },
          "source": {
            "type": "string",
            "minLength": 4,
            "maxLength": 200,
            "description": "Where the meaning was observed/confirmed."
          }
        },
        "required": ["symbol", "id", "name", "verified", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "version", "badges"],
  "additionalProperties": false
}
